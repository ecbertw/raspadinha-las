{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raspadinha-las",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RAFFLE", "class_name": "RaffleStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaffleStore"] }
  ]
}
